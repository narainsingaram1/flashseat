{$DOMAIN} {
	encode zstd gzip

	# API, control plane and the live SSE stream (Caddy flushes event streams
	# immediately, so the seat map stays live).
	handle /api/* {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
