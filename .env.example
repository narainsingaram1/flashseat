# --- Local development (docker compose up) ---
# Web client: where the browser reaches the gateway.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Shared by every API replica to sign waiting-room tokens.
ADMISSION_SECRET=change-me

# --- Production (docker-compose.prod.yml) ---
# Public hostname whose DNS A/AAAA record points at this server. Caddy gets the
# HTTPS certificate for it automatically.
DOMAIN=flashseat.example.com
# Generate both with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# ADMISSION_SECRET above is required too.
